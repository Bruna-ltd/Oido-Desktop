+/// Points one notch of a mouse wheel scrolls. Browsers move about 100, but a wheel applied 1:1
+/// with no glide or acceleration felt slow at that, and at 40 before it.
+pub(crate) const WHEEL_NOTCH: f32 = 180.0;
+
+/// Multiplier on pixel deltas (a trackpad, or a wheel the system smooths). macOS, Windows and
+/// browsers accelerate them before the app sees them. Wayland and X11 hand over raw finger travel,
+/// which applied 1:1 moved a whole swipe only about 140 points: scrolling felt slow and heavy.
+const PIXEL_GAIN: f32 = if cfg!(target_os = "linux") { 2.5 } else { 1.0 };
+
 /// A wheel event's delta in points, positive moving content right and down. With Shift, a delta
 /// with no horizontal part turns horizontal, as browsers and Windows and Linux apps do for a
 /// mouse wheel. macOS turns it itself (`shift` is false there), and a delta that already has a
 /// horizontal part was turned by the system or comes from a trackpad.
 pub(crate) fn wheel_delta(delta: winit::event::MouseScrollDelta, scale: f32, shift: bool) -> (f32, f32) {
     let (dx, dy) = match delta {
-        winit::event::MouseScrollDelta::PixelDelta(p) => (p.x as f32 / scale, p.y as f32 / scale),
-        winit::event::MouseScrollDelta::LineDelta(x, y) => (x * 40.0, y * 40.0),
+        winit::event::MouseScrollDelta::PixelDelta(p) => (p.x as f32 / scale * PIXEL_GAIN, p.y as f32 / scale * PIXEL_GAIN),
+        winit::event::MouseScrollDelta::LineDelta(x, y) => (x * WHEEL_NOTCH, y * WHEEL_NOTCH),
     };
     if shift && dx == 0.0 { (dy, 0.0) } else { (dx, dy) }
 }
